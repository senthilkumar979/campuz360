# Fill with YOUR cohort Supabase project (do not commit real values)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Shell rewrites — use 127.0.0.1 (IPv4) so Node server fetches don't hit ::1-only binds
NEXUS_URL=http://localhost:3001
FLOW_URL=http://localhost:3002
CONNECT_URL=http://localhost:3003
SPHERE_URL=http://localhost:3004
RESIDENCE_URL=http://localhost:3005
PULSE_URL=http://localhost:3006

# Browser origin for auth redirects (prefer localhost in the browser)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Connect email (Phase 2+) — server only, never NEXT_PUBLIC_
# RESEND_API_KEY=
# CONNECT_FROM_EMAIL=noreply@example.com
